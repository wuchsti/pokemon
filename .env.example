# Copy this file to .env (next to this file, at the repo root) for local
# development, or set the same values as real environment variables in the
# Plesk hosting panel for production. Never commit the real .env file.

DB_HOST=localhost
DB_NAME=pokevault
DB_USER=pokevault
DB_PASS=

JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=604800

TCG_API_BASE_URL=https://api.pokemontcg.io/v2
TCG_API_KEY=

# Vision API for the camera-scan / OCR feature (Phase 3). Any
# OpenAI-compatible chat-completions endpoint with image input works.
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_API_MODEL=gpt-4o-mini

CORS_ALLOWED_ORIGIN=*
